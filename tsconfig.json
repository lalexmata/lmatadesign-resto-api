{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@modules/*": ["src/modules/*"],
      "@auth/*": ["src/modules/auth/*"],
      "@categories/*": ["src/modules/categories/*"],
      "@clients/*": ["src/modules/clients/*"],
      "@database/*": ["src/modules/database/*"],
      "@inventario/*": ["src/modules/inventario/*"],
      "@orders/*": ["src/modules/orders/*"],
      "@products/*": ["src/modules/products/*"],
      "@tables/*": ["src/modules/tables/*"],
      "@users/*": ["src/modules/users/*"],
      "@payment/*": ["src/modules/payment/*"]
    }
  }
}
